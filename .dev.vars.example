# Copy to .dev.vars for local development. Never commit .dev.vars.
# On Cloudflare, set each value with: npx wrangler secret put <NAME>

# Supabase project "sita" (ref kjifgddikkofazmndlxu) (Project Settings -> API). The service role key
# bypasses all security rules: server only, never in client code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Robinhood Chain RPC (e.g. Alchemy). Hourly prices are read from chain through it.
# The URL contains your API key: keep it secret.
ROBINHOOD_RPC_URL=

# Random string guarding /api/cron/tick. Also stored in Supabase Vault for the
# pg_cron trigger (session 1.2).
CRON_SECRET=

# Signs the wallet session cookie (session 1.4).
SESSION_SECRET=

# Privy (email and Google login), from dashboard.privy.io -> your app -> Settings.
# Leave both blank to offer wallet login only.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
