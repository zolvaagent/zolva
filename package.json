{
  "name": "pitwise",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "deploy:prototype": "wrangler deploy -c wrangler.prototype.jsonc",
    "backfill": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backfill-candles.mts",
    "backtest": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backtest.mts",
    "seed:house": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-house-agents.mts",
    "deploy:prod": "node scripts/deploy-production.mjs",
    "credits:grant": "node scripts/grant-credits.mts",
    "live:setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/live-signer-setup.mts",
    "live:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/live-swap-test.mts",
    "live:agent": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/live-agent-create.mts",
    "x402:setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/x402-relayer-setup.mts",
    "x402:pay": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/x402-pay-test.mts",
    "x402:export-relayer": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/x402-relayer-export.mts",
    "x402:export-rule": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/x402-relayer-export-rule.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@privy-io/node": "^0.37.0",
    "@privy-io/react-auth": "^3.51.0",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "viem": "^2.57.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.15",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "overrides": {
    "permissionless": {
      "ox": "$ox"
    }
  }
}
