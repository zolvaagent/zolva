// zolva-lighter: signs and sends Lighter RH perps orders for real money agents. No public route: the main
// Worker calls it through a service binding. Secrets (wrangler secret put … -c workers/lighter/wrangler.jsonc):
//   INTERNAL_TOKEN  shared with the main Worker
//   LIGHTER_KEYS    { "<accountIndex>": { "apiKeyIndex": 4, "privateKey": "<hex>" } }
// Before deploying, run `npm run lighter:signer` (downloads the pinned signer into vendor/).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "zolva-lighter",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    // Mainnet Lighter RH (owner's yes 2026-11-26). Testnet: https://api.rh-testnet.lighter.xyz with chain id 300.
    "LIGHTER_API": "https://api.rh.lighter.xyz",
    "LIGHTER_CHAIN_ID": "466324",
    // The kill switch: orders only run while this is "true".
    "LIGHTER_ENABLED": "false"
  },
  "observability": { "enabled": true }
}
